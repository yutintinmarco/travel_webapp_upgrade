rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function memberPath(tripId, uid) {
      return /databases/$(database)/documents/trips/$(tripId)/members/$(uid);
    }

    function canReadTrip(tripId) {
      return signedIn() && request.auth.uid in get(tripPath(tripId)).data.memberUids;
    }

    function roleFor(tripId) {
      return signedIn() && exists(memberPath(tripId, request.auth.uid))
        ? get(memberPath(tripId, request.auth.uid)).data.role
        : null;
    }

    function canManageTrip(tripId) {
      return roleFor(tripId) in ['owner', 'admin'];
    }

    function isOwner(tripId) {
      return roleFor(tripId) == 'owner';
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /trips/{tripId} {
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;

      // Phase 2C bootstrap: signed-in users may probe one trip document by ID so the
      // client can distinguish create vs replace before importing. Trip content remains
      // member-only. Phase 2F will replace this with a stricter access-index pattern.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if canManageTrip(tripId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberUids == resource.data.memberUids;
      allow delete: if isOwner(tripId);

      match /members/{uid} {
        allow read: if canReadTrip(tripId);
        allow create: if signedIn() && (
          (uid == request.auth.uid
            && request.resource.data.role == 'owner'
            && getAfter(tripPath(tripId)).data.createdBy == request.auth.uid)
          || canManageTrip(tripId)
        );
        allow update, delete: if canManageTrip(tripId);
      }

      match /days/{dayId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canManageTrip(tripId);

        match /items/{itemId} {
          allow read: if canReadTrip(tripId);
          allow create, update, delete: if canManageTrip(tripId);
        }
      }

      match /savedPlaces/{placeId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canManageTrip(tripId);
      }

      match /settings/{settingId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canManageTrip(tripId);
      }

      match /snapshots/{snapshotId} {
        allow read: if canManageTrip(tripId);
        allow create: if canManageTrip(tripId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(tripId);
      }

      match /activityLogs/{logId} {
        allow read: if canReadTrip(tripId);
        allow create: if canManageTrip(tripId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /expenses/{expenseId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canManageTrip(tripId)
          || roleFor(tripId) == 'member';
      }

      // Expense settlement/payment records use a separate collection.
      // It must follow the same per-trip access model as expense records.
      match /settlements/{settlementId} {
        allow read: if canReadTrip(tripId);
        allow create, update, delete: if canManageTrip(tripId)
          || roleFor(tripId) == 'member';
      }
    }
  }
}
